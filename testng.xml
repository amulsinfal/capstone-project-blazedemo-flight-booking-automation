<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="BlazeDemo Suite" parallel="methods" thread-count="3">
	<listeners>
		<listener class-name="com.blazedemo.listeners.TestListeners" />
	</listeners>
	<parameter name="browser" value="Chrome" />
	<test name="BlazeDemo Tests">
		<groups>
			<run>
				<include name="Smoke" />
				<include name="Functional" />
				<include name="Data-driven" />
				<include name="Negative" />
			</run>
		</groups>
		<classes>
			<class name="com.blazedemo.tests.FlightBookingTest">
			</class>
		</classes>
	</test>
</suite> 
